{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "../dist",
    "rootDir": "./",
    "noImplicitAny": false,
    "strict": false,
    "declaration": false
  },
  "include": ["."],
  "exclude": ["*.js", "**/*.js", "../backup_js/*", "../backup_jsx/*"],
  "references": [{ "path": "../tsconfig.node.json" }]
}

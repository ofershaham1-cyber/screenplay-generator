{
  "name": "node-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "nodemon --exec tsx server.ts",
    "start:ts": "npm run start",
    "client": "vite",
    "dev": "concurrently \"npm run start\" \"npm run client\"",
    "dev:ts": "npm run dev",
    "build": "vite build",
    "build:server": "tsc",
    "build:all": "npm run build:server && npm run build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:watch": "playwright test --watch",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:log": "tail -f test-results/test.log 2>/dev/null || echo 'Waiting for test log...'",
    "tdd": "concurrently \"npm run dev\" \"npm run test:watch\" \"npm run test:log\""
  },
  "dependencies": {
    "@openrouter/sdk": "^0.3.11",
    "@playwright/mcp": "^0.0.68",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  }
}
